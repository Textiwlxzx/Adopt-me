FROM node:24-alpine3.24

WORKDIR /app

# ติดตั้ง dependencies ที่จำเป็นสำหรับ Alpine
RUN apk add --no-cache libc6-compat

# ก๊อปปี้ไฟล์ package เพื่อลง dependencies ก่อน (เพื่อใช้ Docker Cache)
COPY package*.json ./

# ติดตั้ง Dependencies
RUN npm install

# ก๊อปปี้ไฟล์ทั้งหมดในโปรเจกต์
COPY . .

# เปิดพอร์ตมาตรฐานสำหรับ Next.js (3000)
EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# สั่งรัน Next.js ในโหมด Development (Hot Reload)
CMD ["npm", "run", "dev"]