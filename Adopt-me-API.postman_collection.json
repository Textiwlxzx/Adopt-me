{
  "info": {
    "_postman_id": "adopt-me-api-collection",
    "name": "Adopt-Me API (v1)",
    "description": "Collection for testing Adopt-Me Backend API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register (สมัครสมาชิกใหม่)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"สมชาย ใจดี\",\n  \"email\": \"somchai@example.com\",\n  \"password\": \"password1234\",\n  \"phone\": \"0812345678\",\n  \"role\": \"adopter\",\n  \"address\": \"123/45 ถนนสุขุมวิท กรุงเทพมหานคร\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "2. Login (เข้าสู่ระบบ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"somchai@example.com\",\n  \"password\": \"password1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Animals",
      "item": [
        {
          "name": "3. Register New Animal (ลงทะเบียนสัตว์ใหม่)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"น้องส้ม\",\n  \"species\": \"cat\",\n  \"breed\": \"ไทยสลิด\",\n  \"age\": 2,\n  \"gender\": \"male\",\n  \"health_condition\": \"แข็งแรง ได้รับวัคซีนรวมเข็มแรกแล้ว\",\n  \"personality_note\": \"เชื่อง ชอบให้อุ้ม ขี้เล่น\",\n  \"photo_url\": \"https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba\",\n  \"location_found\": \"สวนลุมพินี ประตู 3\",\n  \"status\": \"street\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/animals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "animals"]
            }
          }
        },
        {
          "name": "4. Get All Animals (ดึงรายการสัตว์ทั้งหมด)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/animals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "animals"]
            }
          }
        },
        {
          "name": "5. Get All Animals (Filter by Species & Status)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/animals?species=cat&status=street",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "animals"],
              "query": [
                {
                  "key": "species",
                  "value": "cat"
                },
                {
                  "key": "status",
                  "value": "street"
                }
              ]
            }
          }
        },
        {
          "name": "6. Get Animal By ID (ดูรายละเอียดรายตัว)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/animals/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "animals", "1"]
            }
          }
        }
      ]
    }
  ]
}
