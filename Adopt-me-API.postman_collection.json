{
  "info": {
    "_postman_id": "adopt-me-api-collection-v1",
    "name": "Adopt-Me API (Full Complete)",
    "description": "Postman Collection ครอบคลุมทุก Endpoint สำหรับ Adopt-Me API ตามสเปก พร้อม Auto-Save Token และ Scripts ทดสอบ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token_adopter",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_caretaker",
      "value": "",
      "type": "string"
    },
    {
      "key": "animal_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "application_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Health status ok', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "1.1 Register Adopter (สมัครสมาชิก Adopter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token_adopter', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"สมชาย ผู้รับเลี้ยง\",\n  \"email\": \"adopter@example.com\",\n  \"password\": \"password1234\",\n  \"phone\": \"0812345678\",\n  \"role\": \"adopter\",\n  \"address\": \"123/45 ถนนสุขุมวิท กรุงเทพมหานคร\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Register Caretaker (สมัครสมาชิก Caretaker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token_caretaker', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"หมอใจดี ผู้ดูแลสัตว์\",\n  \"email\": \"caretaker@example.com\",\n  \"password\": \"password1234\",\n  \"phone\": \"0898765432\",\n  \"role\": \"caretaker\",\n  \"address\": \"99/1 คลินิกสัตว์ พญาไท กรุงเทพฯ\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "1.3 Login (เข้าสู่ระบบ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token_adopter', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"adopter@example.com\",\n  \"password\": \"password1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Animals",
      "item": [
        {
          "name": "2.1 Register New Animal (แจ้ง/ลงทะเบียนสัตว์ใหม่ - Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('animal_id', jsonData.data.id.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"น้องส้ม\",\n  \"species\": \"cat\",\n  \"breed\": \"ไทยสลิด\",\n  \"age\": 2,\n  \"gender\": \"male\",\n  \"health_condition\": \"แข็งแรง ได้รับวัคซีนรวมเข็มแรกแล้ว\",\n  \"personality_note\": \"เชื่อง ชอบให้อุ้ม ขี้เล่น\",\n  \"photo_url\": \"https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba\",\n  \"location_found\": \"สวนลุมพินี ประตู 3\",\n  \"status\": \"street\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/animals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "animals"]
            }
          }
        },
        {
          "name": "2.2 Get All Animals (ดึงรายการสัตว์ทั้งหมด - Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/animals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "animals"]
            }
          }
        },
        {
          "name": "2.3 Get Animal By ID (ดูรายละเอียดสัตว์แต่ละตัว - Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/animals/{{animal_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "animals", "{{animal_id}}"]
            }
          }
        },
        {
          "name": "2.4 Claim Animal (รับเป็นคนดูแล - Caretaker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_caretaker}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/animals/{{animal_id}}/claim",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "animals", "{{animal_id}}", "claim"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Adoption Applications",
      "item": [
        {
          "name": "3.1 Submit Application (ส่งใบสมัครขอรับเลี้ยง - Adopter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('application_id', jsonData.data.id.toString());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_adopter}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"animal_id\": {{animal_id}},\n  \"reason\": \"รักสัตว์ เลี้ยงระบบปิดในบ้านเดี่ยว มีประสบการณ์เลี้ยงแมวมาก่อน\",\n  \"home_environment\": \"บ้านเดี่ยว 2 ชั้น มีพื้นที่กว้างขวาง รั้วรอบขอบชิด\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/adoption-applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "adoption-applications"]
            }
          }
        },
        {
          "name": "3.2 Get My Applications (ดูสถานะใบสมัครของตัวเอง - Adopter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_adopter}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/adoption-applications/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "adoption-applications", "me"]
            }
          }
        },
        {
          "name": "3.3 Update Application Status (อนุมัติ/ปฏิเสธใบสมัคร - Caretaker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_caretaker}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/adoption-applications/{{application_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "adoption-applications", "{{application_id}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Follow-ups",
      "item": [
        {
          "name": "4.1 Create Follow-up (บันทึกผลการติดตามหลังรับเลี้ยง - Caretaker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_caretaker}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application_id\": {{application_id}},\n  \"visit_date\": \"2026-11-20\",\n  \"note\": \"น้องแมวปรับตัวเข้ากับเจ้าของใหม่ได้ดี สุขภาพแข็งแรง ร่าเริง กินอาหารได้ปกติ\",\n  \"status\": \"good\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/follow-ups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "follow-ups"]
            }
          }
        },
        {
          "name": "4.2 Get Follow-ups (ดูผลการติดตาม - Caretaker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_caretaker}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/follow-ups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "follow-ups"]
            }
          }
        }
      ]
    }
  ]
}
